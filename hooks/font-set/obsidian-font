#!/bin/bash

# Omarchy font-set hook: sync the system monospace font to every Obsidian vault
# as the CSS snippet "omarchy-font". Called with the font family name; without
# one it uses the current font, so it can also be run by hand.
#
# The snippet sets Obsidian's resolved font variables directly, so it wins over
# the fonts picked in Settings -> Appearance. Disable the snippet to use those.

font_name="${1:-$(omarchy-font-current)}"
[[ -n $font_name ]] || exit 0

jq -r '.vaults | values[].path' ~/.config/obsidian/obsidian.json 2>/dev/null | while read -r vault_path; do
  [[ -d $vault_path/.obsidian ]] || continue

  mkdir -p "$vault_path/.obsidian/snippets"
  cat >"$vault_path/.obsidian/snippets/omarchy-font.css" <<EOF
/* Omarchy font: generated by the font-set hook, do not edit */
body {
  --font-interface: "$font_name", var(--font-default);
  --font-text: "$font_name", var(--font-default);
  --font-monospace: "$font_name", var(--font-monospace-default);
}
EOF
done
