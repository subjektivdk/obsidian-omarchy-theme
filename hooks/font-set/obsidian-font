#!/bin/bash

# Omarchy font-set hook: sync the Omarchy font to every Obsidian vault as the
# CSS snippet "omarchy-font". Called with the font family name; without one it
# uses the current font, so it can also be run by hand.
#
# The snippet sets Obsidian's interface, text and monospace fonts, so the whole
# app follows the Omarchy font and it wins over the fonts picked in
# Settings -> Appearance. Disable the snippet to use those.

font_name="${1:-$(omarchy-font-current)}"
[[ -n $font_name ]] || exit 0

# Escape for a double-quoted CSS string; drop control characters.
css_font=${font_name//[[:cntrl:]]/}
css_font=${css_font//\\/\\\\}
css_font=${css_font//\"/\\\"}

# Obsidian's vault registry: native, Flatpak and Snap installs.
registries=(
  "${XDG_CONFIG_HOME:-$HOME/.config}/obsidian/obsidian.json"
  "$HOME/.var/app/md.obsidian.Obsidian/config/obsidian/obsidian.json"
  "$HOME/snap/obsidian/current/.config/obsidian/obsidian.json"
)

snippet=$(
  cat <<EOF
/* Omarchy font: generated by the font-set hook, do not edit */
body {
  --font-interface: "$css_font", var(--font-default);
  --font-text: "$css_font", var(--font-default);
  --font-monospace: "$css_font", var(--font-monospace-default);
}
EOF
)

for registry in "${registries[@]}"; do
  [[ -f $registry ]] || continue

  vault_paths=$(jq -r '.vaults // {} | .[].path // empty' "$registry") || {
    echo "obsidian-font: cannot read $registry" >&2
    continue
  }

  while IFS= read -r vault_path; do
    [[ -d $vault_path/.obsidian ]] || continue

    dir=$vault_path/.obsidian/snippets
    file=$dir/omarchy-font.css

    # Skip when already up to date, so Obsidian isn't told to reload for nothing.
    [[ -f $file && $(<"$file") == "$snippet" ]] && continue

    # Write to a temp file and rename, so Obsidian never sees a half-written snippet.
    if ! { mkdir -p "$dir" && printf '%s\n' "$snippet" >"$file.tmp" && mv "$file.tmp" "$file"; }; then
      echo "obsidian-font: cannot write $file" >&2
      rm -f "$file.tmp"
    fi
  done <<<"$vault_paths"
done
